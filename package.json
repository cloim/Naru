    "ag-grid-react": "36.1.0",
    "chart.js": "^4.6.1",
    "clsx": "^2.1.1",
    "express": "^5.1.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.18.0",
    "yaml": "^2.8.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.3.3",
