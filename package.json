{
  "name": "naru",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "build:agent": "cargo build -p naru-agent --release --target x86_64-unknown-linux-musl && node -e \"require('fs').copyFileSync('target/x86_64-unknown-linux-musl/release/naru-agent','scripts/naru-agent')\"",
    "build:desktop": "tauri build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
